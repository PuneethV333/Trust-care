{
  "$schema": "https://swc.rs/schema.json",
  "exclude": [".*\\.spec\\.ts$", "node_modules"],
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2023",
    "keepClassNames": true
  },
  "module": {
    "type": "commonjs"
  },
  "sourceMaps": false
}